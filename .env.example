# AI Home Care Management
# Public environment variable template
# Copy this file to .env before starting the local environment.
# Never place real passwords, tokens, or API keys in this file.

# Project
COMPOSE_PROJECT_NAME=ai-home-care-management
TZ=Asia/Taipei

# PostgreSQL
POSTGRES_DB=careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=replace_with_a_strong_password

# NocoBase
NOCOBASE_APP_KEY=replace_with_a_random_app_key

# n8n
N8N_ENCRYPTION_KEY=replace_with_a_random_encryption_key

# External URLs
NOCOBASE_PUBLIC_URL=
N8N_WEBHOOK_URL=

# AI service
AI_API_KEY=

# Notification service
NOTIFICATION_WEBHOOK_URL=