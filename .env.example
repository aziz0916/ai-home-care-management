# AI Home Care Management — public environment template
# Copy to .env and replace every CHANGE_ME value before starting Docker.

COMPOSE_PROJECT_NAME=ai-home-care-management
TZ=Asia/Taipei

# PostgreSQL
POSTGRES_DB=careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# NocoBase
NOCOBASE_APP_KEY=CHANGE_ME_RANDOM_NOCOBASE_APP_KEY

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_N8N_ENCRYPTION_KEY

# Local ports
NOCOBASE_PORT=13001
N8N_PORT=5679
MAILPIT_WEB_PORT=8026
MAILPIT_SMTP_PORT=1026
