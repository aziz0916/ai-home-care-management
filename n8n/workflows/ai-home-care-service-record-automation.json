            {
              "id": "4d890c8c-029d-408c-9b90-f0f6a9229f8c",
              "name": "ai_prompt",
              "value": "={{ `你是居家照護服務紀錄助理。請根據以下資料產生一段專業、客觀、精簡的繁體中文照護摘要，限80字以內。不得虛構資料，也不要提供醫療診斷。\n\n個案：${$json.client_name}\n服務日期：${$json.service_date}\n服務類型：${$json.service_type}\n服務分鐘數：${$json.service_minutes}\n服務內容與備註：${$json.service_notes || '無'}\n是否跌倒：${$json.fall ? '是' : '否'}\n異常說明：${$json.abnormal_description || '無'}\n\n只輸出摘要內容，不要加上「摘要：」等標題。` }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
